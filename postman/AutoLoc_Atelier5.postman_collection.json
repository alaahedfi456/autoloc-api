              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contrats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contrats"]
            }
          }
        },
