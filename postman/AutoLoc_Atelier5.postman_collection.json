                  "    pm.expect(json.idContrat).to.be.above(0);",
                  "    pm.expect(json.paiements).to.be.an(\"array\").with.lengthOf(2);",
                  "    pm.environment.set(\"contratId\", json.idContrat);",
                  "    if (json.paiements.length > 0) {",
                  "        pm.environment.set(\"paiementId\", json.paiements[0].idPaiement);",
